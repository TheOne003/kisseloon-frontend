{
  "expo": {
    "name": "Kisse Loon",
    "slug": "kisseloon-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Kisseloon to use the camera to scan QR codes and barcodes.",
        "NSLocationWhenInUseUsageDescription": "Allow Kisse Loon to use your location to show delivery prices near you."
      }
    },
    "android": {
      "package": "com.kisseloon.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Kisseloon to use the camera to scan QR codes and barcodes.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Kisse Loon to use your location to show delivery prices near you."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-video",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "a40fb5dd-f4c5-4bc8-b1d6-ea10285843cd"
      }
    },
    "owner": "theone003"
  }
}
